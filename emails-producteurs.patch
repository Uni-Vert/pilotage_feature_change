+      +'</td><td style="'+td+'text-align:right;white-space:nowrap">'+montantMail(d.ht)+'</td><td style="'+td+'">'+echapHtml((d.infoProducteur||'').trim()).replace(/\r?\n/g,'<br>')+'</td></tr>';
