+// ---- Emails aux producteurs (Info producteur a notifier) ----
+// Une ligne est "a notifier" quand son Info producteur a ete modifiee dans la page et pas encore notifiee.
+// L'email s'ouvre dans Outlook (mailto) ; le corps avec tableau est copie dans le presse-papiers (Ctrl+V).
+var MAIL_OBJET='PO 2026 \u2013 Informations sur vos d\u00e9penses';
+var mailOuverts={}; // producteur -> 'ok' | 'echec' : email ouvert, en attente de confirmation d'envoi
+function depsANotifier(){
+  return state.deps.filter(function(d){return d.infoANotifier&&d.prod&&(d.infoProducteur||'').trim();});
+}
+function groupesANotifier(){
+  var g={};
+  depsANotifier().forEach(function(d){(g[d.prod]=g[d.prod]||[]).push(d);});
+  return Object.keys(g).sort().map(function(prod){return {prod:prod,deps:g[prod]};});
+}
+function groupeDe(prod){return groupesANotifier().find(function(x){return x.prod===prod;});}
+function majBoutonEmails(){
+  var b=document.getElementById('btn-emails');if(!b)return;
+  var n=depsANotifier().length;
+  b.textContent='Preparer les emails ('+n+')';
+  b.disabled=!n;
+}
+function emailsDe(prod){
+  var re=/^[^\s@;,]+@[^\s@;,]+\.[^\s@;,]+$/;
+  var liste=(findProd(prod).mail||'').split(/[;,]/).map(function(s){return s.trim();}).filter(Boolean);
+  return {valides:liste.filter(function(s){return re.test(s);}),invalides:liste.filter(function(s){return !re.test(s);})};
+}
+function echapHtml(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
